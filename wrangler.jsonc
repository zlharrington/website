{
  "name": "website",
  "main": "direct-ticket-worker.js",
  "compatibility_date": "2026-07-13",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  }
}
